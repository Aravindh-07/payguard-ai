# PayGuard AI - Example environment configuration
# Copy this file to `.env` and adjust values as needed.
# .env is git-ignored and should NEVER be committed.
#
# None of these are required to run the project locally with default
# settings — they exist so the API/dashboard ports and risk thresholds
# can be customized without editing source code.

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Dashboard server ---
DASHBOARD_PORT=8501

# --- Risk scoring thresholds (0-100 scale) ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# --- Database ---
DATABASE_PATH=data/payguard.db
